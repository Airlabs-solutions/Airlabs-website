# Create a key at https://resend.com and verify airlabss.com.
# CONTACT_FROM_EMAIL must be an address on that verified domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=AirLabs Solutions <info@airlabss.com>

# GA4 measurement ID (G-…). Leave empty to keep analytics off.
# Set the same value in Vercel, then redeploy.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
